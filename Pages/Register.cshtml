@page
@model Task4.Pages.RegisterModel
@{
    ViewData["Title"] = "Sign up";
}

<div class="auth-wrap">
    <div class="auth-card">
        <div class="text-center">
            <h1>Create Account</h1>
            <p class="subtitle">Enter your details to get started.</p>
        </div>

        <div asp-validation-summary="All" class="text-danger"></div>

        <form method="post">
            <div class="mb-3">
                <label asp-for="Input.UserName" class="form-label">Username</label>
                <input asp-for="Input.UserName" class="form-control" placeholder="Enter your username" />
            </div>

            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label">Email</label>
                <input asp-for="Input.Email" class="form-control" placeholder="Enter your Email" />
            </div>

            <div class="mb-3">
                <label asp-for="Input.Password" class="form-label">Password</label>
                <div class="pass-wrap">
                    <input asp-for="Input.Password" class="form-control" placeholder="Enter Password" />
                    <button type="button" class="pass-eye" aria-label="Show password">
                        <span class="eye-open">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                        </span>
                        <span class="eye-close d-none">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94" />
                                <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19" />
                                <line x1="1" y1="1" x2="23" y2="23" />
                            </svg>
                        </span>
                    </button>
                </div>
            </div>

            <div class="mb-4">
                <label asp-for="Input.ConfirmPassword" class="form-label">Confirm password</label>
                <div class="pass-wrap">
                    <input asp-for="Input.ConfirmPassword" class="form-control" placeholder="Confirm Password" />
                    <button type="button" class="pass-eye" aria-label="Show password">
                        <span class="eye-open">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                        </span>
                        <span class="eye-close d-none">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94" />
                                <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19" />
                                <line x1="1" y1="1" x2="23" y2="23" />
                            </svg>
                        </span>
                    </button>
                </div>
            </div>

            <button type="submit" class="btn btn-accent w-100 mb-4">Sign up</button>
        </form>

        <p class="text-center mb-0 text-muted">
            Already have an account? <a asp-page="/Login">Sign in</a>
        </p>
    </div>
</div>
