@page
@model Task4.Pages.AdminPanelModel
@{
    ViewData["Title"] = "Users";
}

@if (!ViewData.ModelState.IsValid)
{
    <div class="error-banner" role="alert">
        <div asp-validation-summary="All"></div>
    </div>
}

<div class="panel-wrap">
    <div class="panel-card">
        <h1 class="h4 mb-3">Users</h1>

        <form method="post" id="usersForm">
            <div class="toolbar">
                <button type="submit" class="btn btn-sm btn-accent-outline bulk-action" disabled
                        asp-page-handler="DeleteSelectedUsers" title="Delete selected">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6" /><path d="M19 6l-1 14H6L5 6" /><path d="M10 11v6" /><path d="M14 11v6" /><path d="M9 6V4h6v2" /></svg>
                    Delete
                </button>
                <button type="submit" class="btn btn-sm btn-accent-outline bulk-action" disabled
                        asp-page-handler="BlockSelectedUsers" title="Block selected">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
                    Block
                </button>
                <button type="submit" class="btn btn-sm btn-accent-outline bulk-action" disabled
                        asp-page-handler="UnblockSelectedUsers" title="Unblock selected">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 9.9-1" /></svg>
                    Unblock
                </button>
                <button type="submit" class="btn btn-sm btn-accent-outline bulk-action" disabled
                        asp-page-handler="DeleteSelectedUnverifiedUsers" title="Delete unverified">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21h18" /><path d="M5 21V10l7-7 7 7v11" /><path d="M9 21v-6h6v6" /></svg>
                    Clean unverified
                </button>
            </div>

            <div class="users-table">
                <div class="users-head">
                    <div class="user-col user-col-check"></div>
                    <div class="user-col user-col-name">Name</div>
                    <div class="user-col user-col-email">Email</div>
                    <div class="user-col user-col-status">Status</div>
                    <div class="user-col user-col-activity">Last activity</div>
                    <div class="user-col user-col-actions"></div>
                </div>
                @if (Model.CurrentUser != null)
                {
                    ViewData["IsCurrent"] = true;
                    <partial name="_UserRow" model="Model.CurrentUser" />
                }
                @foreach (var u in Model.AllUsers)
                {
                    ViewData["IsCurrent"] = false;
                    <partial name="_UserRow" model="u" />
                }
            </div>
        </form>
    </div>
</div>