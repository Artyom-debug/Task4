@model Task4.Dtos.ApplicationUserDto
@using Task4.Models
@{
    var isCurrent = ViewData["IsCurrent"] as bool? == true;
}
<div class="user-row @(isCurrent ? "current" : null)">
    <div class="user-col user-col-check">
        <input class="form-check-input user-check" type="checkbox" name="selectedIds" value="@Model.UserId" />
    </div>
    <div class="user-col user-col-name">
        <span class="name">
            @Model.UserName
            @if (isCurrent)
            {
                <span class="text-muted fw-normal">(you)</span>
            }
        </span>
    </div>
    <div class="user-col user-col-email">
        <span class="email">@Model.Email</span>
    </div>
    <div class="user-col user-col-status">
        <span class="status-badge status-@Model.Status">@Model.Status</span>
    </div>
    <div class="user-col user-col-activity">
        <span class="activity">@Model.LastActivity</span>
    </div>
    <div class="user-col user-col-actions">
        <button type="submit" class="btn-icon danger" name="userId" value="@Model.UserId"
                asp-page-handler="DeleteUser" title="Delete">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6" /><path d="M19 6l-1 14H6L5 6" /><path d="M10 11v6" /><path d="M14 11v6" /><path d="M9 6V4h6v2" /></svg>
        </button>
        @if (Model.Status == Status.blocked)
        {
            <button type="button" class="btn-icon" disabled title="Block">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
            </button>
        }
        else
        {
            <button type="submit" class="btn-icon" name="userId" value="@Model.UserId" asp-page-handler="BlockUser" title="Block">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
            </button>
        }
        @if (Model.Status != Status.blocked)
        {
            <button type="button" class="btn-icon" disabled title="Unblock">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 9.9-1" /></svg>
            </button>
        }
        else
        {
            <button type="submit" class="btn-icon" name="userId" value="@Model.UserId" asp-page-handler="UnblockUser" title="Unblock">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 9.9-1" /></svg>
            </button>
        }
        @if (Model.Status != Status.unverified)
        {
            <button type="button" class="btn-icon" disabled title="Delete unverified">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21h18" /><path d="M5 21V10l7-7 7 7v11" /><path d="M9 21v-6h6v6" /></svg>
            </button>
        }
        else
        {
            <button type="submit" class="btn-icon" name="userId" value="@Model.UserId" asp-page-handler="DeleteUnverified" title="Delete unverified">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21h18" /><path d="M5 21V10l7-7 7 7v11" /><path d="M9 21v-6h6v6" /></svg>
            </button>
        }
    </div>
</div>